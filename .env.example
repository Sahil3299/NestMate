# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/nestmate

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_64_chars
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=another_long_random_secret_for_refresh_tokens
JWT_REFRESH_EXPIRE=7d

# ── CORS ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Uploads ───────────────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=5

# ── Email (use Mailtrap for dev) ──────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
FROM_EMAIL=noreply@nestmate.in
FROM_NAME=Nestmate

# ── Frontend (Vite) ───────────────────────────────────────
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_NAME=Nestmate
